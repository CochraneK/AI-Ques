{
  "schema_version": 1,
  "study_id": "ai-ques-interaction-prototype",
  "study_version": "0.6.0-prototype",
  "status": "prototype_only",
  "formal_data_collection_authorized": false,
  "manifest_date": "2026-09-15",
  "purpose": "Compare interaction formats for psychological-assessment research prototypes without claiming diagnostic or validated-score equivalence.",
  "language": {
    "ui": "zh-CN",
    "instrument_wording_status": "prototype_paraphrase",
    "validated_target_language_baseline": false
  },
  "scales": {
    "pcl5": {
      "label": "PCL-5",
      "items": 20,
      "response_encoding": "0-4",
      "source_status": "public-domain source instrument; Chinese wording in this repo is prototype paraphrase",
      "distress_layer": null,
      "formal_baseline": false,
      "response_instruction": "keep one worst/stressful experience in mind; rate how much each problem bothered the participant in the past month"
    },
    "cape15": {
      "label": "Current CAPE-P15",
      "items": 15,
      "response_encoding": "0-3 frequency + conditional 0-3 distress",
      "source_status": "construct-based prototype paraphrase; not a validated Chinese version",
      "distress_layer": "implemented for core-item modes when frequency >= 1",
      "formal_baseline": false,
      "scoring_scheme": "current-cape-p15-original-0-3"
    }
  },
  "modes": {
    "original": {
      "public_label": "直接问卷",
      "research_role": "baseline-like control",
      "phase": "phase-1 candidate"
    },
    "vassip": {
      "public_label": "VASSIP 式",
      "research_role": "low-transformation experience layer",
      "phase": "phase-1 candidate",
      "evidence_doi": "10.1371/journal.pone.0302429"
    },
    "emoji": {
      "public_label": "Emoji Game 式",
      "research_role": "low-transformation engagement layer",
      "phase": "phase-1 candidate",
      "evidence_doi": "10.1037/pas0001371"
    },
    "rush": {
      "public_label": "HEXACO-RUSH / SJT 式",
      "research_role": "continuous scenario-decision signal",
      "phase": "phase-2",
      "evidence_doi": "10.1016/j.chb.2024.108467"
    }
  },
  "versioning_policy": {
    "update_when": [
      "instrument wording changes",
      "item count or response encoding changes",
      "mode scoring logic changes",
      "research condition labels change",
      "data-collection protocol changes"
    ],
    "freeze_before_formal_data_collection": true,
    "participant_session_schema_required_before_formal_data_collection": true
  },
  "safety": {
    "diagnostic_use": false,
    "treatment_use": false,
    "ethics_review_required_before_formal_research": true,
    "consent_and_withdrawal_flow_required": true,
    "risk_escalation_plan_required_for_screening_use": true
  },
  "presentation_rules": {
    "baseline_construct_codes_visible": false,
    "source_text_visible_by_default": false,
    "source_debug_query": "?source=1",
    "participant_result_default": "completion_only",
    "research_detail_query": "?research=1",
    "no_item_level_score_feedback": true,
    "no_construct_codes_in_baseline": true,
    "assigned_mode_query": "?mode=<mode_id>"
  },
  "mode_taxonomy": {
    "policy": "one baseline plus four evidence-backed primary interaction mechanisms",
    "user_facing_modes": [
      "original",
      "vassip",
      "emoji",
      "rush"
    ],
    "removed_as_independent_modes": [
      "itemscene",
      "construct",
      "aisjt",
      "psychogat_static"
    ],
    "ai_sjt_role": "authoring_method_for_sjt_not_user_facing_condition",
    "mece_scope": "mutually exclusive within P002 experimental arms; not claimed exhaustive of all gamified assessment literature",
    "planned_paradigms": {
      "psychogat": {
        "status": "disabled_until_faithful_agent_implementation",
        "evidence_doi": "10.18653/v1/2024.acl-long.779",
        "reason": "static fixed-path version lacked defining LLM-agent generation/control/evaluator mechanisms and overlapped the SJT arm"
      }
    }
  },
  "mode_quality": {
    "vassip_microtask": "construct-neutral navigation only",
    "emoji_game": "one emoji placement per session",
    "rush": "single-construct scenarios; no coping-skill scoring; no item-level signal feedback",
    "psychogat": "disabled until a faithful LLM-agent implementation exists"
  }
}