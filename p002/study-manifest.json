{
  "schema_version": 2,
  "study_id": "ai-ques-interaction-prototype",
  "study_version": "0.11.0-prototype",
  "status": "prototype_only",
  "formal_data_collection_authorized": false,
  "manifest_date": "2026-09-17",
  "purpose": "Compare administrator-assigned presentation/measurement conditions for PCL-5 and Current CAPE-P15 without participant self-selection.",
  "language": {
    "ui": "zh-CN",
    "instrument_wording_status": "prototype_paraphrase",
    "validated_target_language_baseline": false,
    "instrument_evidence_notes": "p002/RESEARCH_NOTES.md"
  },
  "scales": {
    "pcl5": {
      "label": "PCL-5",
      "items": 20,
      "response_encoding": "0-4",
      "source_status": "public-domain source instrument; Chinese wording in this repo is prototype paraphrase",
      "response_instruction": "keep one worst/stressful experience in mind; rate how much each problem bothered the participant in the past month",
      "formal_baseline": false,
      "chinese_evidence": {
        "published_validation_exists": true,
        "doi": "10.1080/26408066.2019.1676858",
        "repository_wording_is_validated_version": false
      }
    },
    "cape15": {
      "label": "Current CAPE-P15",
      "items": 15,
      "response_encoding": "1-4 frequency + conditional 1-4 distress",
      "scoring_scheme": "published-response-codes-1-4",
      "distress_layer": "implemented for questionnaire conditions when frequency > 1 (never = 1)",
      "source_status": "published Chinese psychometric validation exists; wording in this repo remains a construct-based prototype paraphrase and is not asserted to be the validated Chinese instrument",
      "formal_baseline": false,
      "current_form_source": {
        "doi": "10.1111/eip.12245",
        "target_window": "past 3 months"
      },
      "chinese_evidence": {
        "published_validation_exists": true,
        "doi": "10.1016/j.schres.2020.06.003",
        "validation_frames": [
          "lifetime",
          "past month"
        ],
        "repository_wording_is_validated_version": false
      }
    }
  },
  "presentation_control": {
    "participant_can_choose_condition": false,
    "admin_page": "p002/admin.html",
    "storage_key": "bjtu.p002.condition.v1",
    "default_condition": "story",
    "prototype_scope": "same-browser local control only",
    "production_requirement": "server-authenticated administrator configuration",
    "conditions": {
      "story": {
        "public_behavior": "story questionnaire",
        "research_role": "default gamified self-report wrapper",
        "item_wording_transformed": false,
        "response_format_transformed": false,
        "evidence_basis": "VASSIP-inspired storyfication / immersion / non-evaluable dynamics",
        "evidence_doi": "10.1371/journal.pone.0302429"
      },
      "direct": {
        "public_behavior": "direct questionnaire",
        "research_role": "administrator-assigned baseline-like control",
        "item_wording_transformed": false,
        "response_format_transformed": false
      },
      "scenario": {
        "public_behavior": "scenario selection",
        "research_role": "administrator-assigned transformed assessment",
        "item_wording_transformed": true,
        "response_format_transformed": true,
        "score_equivalent_to_source_scale": false,
        "evidence_basis": "HEXACO-RUSH / gamified-SJT inspired",
        "evidence_doi": "10.1016/j.chb.2024.108467"
      }
    }
  },
  "removed_features": [
    "participant condition picker",
    "Emoji Game",
    "static PsychoGAT",
    "itemscene",
    "construct",
    "AI-SJT"
  ],
  "presentation_rules": {
    "participant_result_default": "completion_only",
    "source_text_visible_by_default": false,
    "source_debug_query": "?source=1",
    "research_detail_query": "?research=1",
    "construct_codes_visible": false,
    "item_level_score_feedback": false
  },
  "safety": {
    "diagnostic_use": false,
    "treatment_use": false,
    "ethics_review_required_before_formal_research": true,
    "consent_and_withdrawal_flow_required": true,
    "risk_escalation_plan_required_for_screening_use": true
  },
  "data_contract": {
    "schema_version": 1,
    "shared_runtime": {
      "config": "shared/config.js",
      "core": "shared/core.js"
    },
    "identifiers": {
      "participant_id": "stable browser-local UUID-like identifier shared across activities",
      "session_id": "new identifier for every P002 run; prior sessions are never overwritten"
    },
    "event_fields": [
      "participant_id",
      "session_id",
      "study_version",
      "scale_id",
      "condition_id",
      "event_type",
      "item_id",
      "cluster",
      "response",
      "distress",
      "response_ms",
      "timestamp"
    ],
    "extra_event_fields": [
      "frequency_response_ms",
      "signal"
    ],
    "local_storage": {
      "participant": "bjtu.p00.participant.v1",
      "sessions": "bjtu.p00.sessions.v1",
      "events": "bjtu.p00.events.v1",
      "pending_sync": "bjtu.p00.pending-sync.v1"
    },
    "sync": {
      "api_config_key": "bjtu.p00.runtime.v1",
      "endpoint": "POST /v1/events",
      "behavior_without_api_base": "retain events in browser-local pending queue",
      "cross_device_sync_available": false
    },
    "admin_export": [
      "JSON",
      "CSV"
    ],
    "response_code_policy": "store questionnaire responses using the published response codes; downstream zero-basing must be explicit and derived"
  },
  "instrument_assets": {
    "formal_target_language_wording_frozen": false,
    "source_permissions_frozen": false,
    "version_hash_frozen": false,
    "evidence_notes": "p002/RESEARCH_NOTES.md"
  }
}
