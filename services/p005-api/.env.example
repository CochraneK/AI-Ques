NODE_ENV=development
PORT=3000

# Production MUST provide DATABASE_URL.
DATABASE_URL=
DATABASE_SSL=

# Comma-separated web origins allowed to call this API.
FRONTEND_ORIGINS=https://cochranek.github.io,http://localhost:8000

# Admin console token. Use a long random secret in production.
ADMIN_TOKEN=

# OpenAI-compatible provider.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
CHAT_MODEL=
MEMORY_MODEL=
IMAGE_MODEL=
TTS_MODEL=
STT_MODEL=
TTS_VOICE=marin

P005_TARGET_HORIZON=4y
P005_INTAKE_PROTOCOL=guided

RATE_LIMIT_PER_MINUTE=180
MODEL_TIMEOUT_MS=60000
IMAGE_TIMEOUT_MS=90000
