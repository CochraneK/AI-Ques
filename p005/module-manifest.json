{
  "schema_version": 1,
  "module_id": "P005",
  "public_name": "Future Me / 未来的我",
  "version": "0.5.0",
  "status": "prototype",
  "updated_at": "2026-09-15",
  "purpose": "Future-self continuity, reflective conversation and time-capsule interaction prototype.",
  "experience": {
    "inspiration": [
      "MIT Future You",
      "FutureMe"
    ],
    "target_future_age": null,
    "core_flow": [
      "protocol-aware sequential life-story intake",
      "P001 profile reuse or compact 24-quality / 16-value matrices",
      "optional present portrait upload",
      "optional age-progressed portrait API",
      "future-memory generation",
      "future-self reveal",
      "profile-grounded future-self conversation",
      "explicit conversation ending",
      "multi-style share card"
    ],
    "enhancements": [
      "natural TTS output",
      "speech-to-text input",
      "optional realtime voice session hook",
      "optional future letter and time capsule"
    ],
    "chat_finish_threshold_messages": 16,
    "target_horizon": {
      "default": "4y",
      "allowed": [
        "1y",
        "2y",
        "3y",
        "4y",
        "10y",
        "age60"
      ],
      "admin_route": "p005/admin.html",
      "local_prototype_key": "bjtu.p005.admin.v1"
    },
    "intake_protocols": {
      "guided": {
        "default": true,
        "response_style": "structured choices plus optional short detail",
        "publication_note": "modified low-burden protocol"
      },
      "replication": {
        "default": false,
        "response_style": "sequential free-text",
        "included_sources": [
          "paper-core",
          "paper-prompt"
        ],
        "publication_note": "paper-aligned, not verbatim survey replication"
      }
    },
    "guided_profile_matrix": {
      "positive_qualities": {
        "pool": 24,
        "max_selected": 6,
        "source": "P001 shared content asset"
      },
      "important_values": {
        "pool": 16,
        "max_selected": 4,
        "source": "P001 shared content asset"
      },
      "interaction": "flat matrix selection, intentionally not P001 interaction"
    }
  },
  "shared_profile": {
    "adapter": "../shared/profile.js",
    "canonical_key": "bjtu.p00.profile.v1",
    "reads": [
      "window.BJTU_PROFILE",
      "window.P00_CONTEXT.profile",
      "window.P00_CONTEXT.p001",
      "window.P001_PROFILE",
      "window.P001_PROFILE_ASSETS"
    ],
    "auto_reuse_fields": [
      "name",
      "age",
      "origin",
      "location",
      "currentWork",
      "values",
      "gender",
      "positiveQualities",
      "selectedQualities",
      "selectedValues"
    ],
    "clinical_admin_fields_exposed_to_user": false
  },
  "api_hooks": {
    "chat": "P005_FUTURE_ME_CONFIG.chatApi or FUTURE_ME_API",
    "image": "P005_FUTURE_ME_CONFIG.imageApi or FUTURE_ME_IMAGE_API",
    "voice": "P005_FUTURE_ME_CONFIG.voiceApi or FUTURE_ME_VOICE_API",
    "admin": "P005_FUTURE_ME_CONFIG.adminApi or P00_ADMIN_API",
    "memory": "P005_FUTURE_ME_CONFIG.memoryApi or FUTURE_ME_MEMORY_API",
    "runtime_config": "p005/runtime-config.js",
    "transcribe": "P005_FUTURE_ME_CONFIG.transcribeApi or FUTURE_ME_TRANSCRIBE_API",
    "realtime_session": "P005_FUTURE_ME_CONFIG.realtimeSessionApi or FUTURE_ME_REALTIME_SESSION_API"
  },
  "admin_events": [
    "session_started",
    "survey_answered",
    "portrait_added",
    "future_generated",
    "future_portrait_generated",
    "chat_turn",
    "capsule_saved",
    "export",
    "session_reset",
    "chat_ended",
    "share_card_generated",
    "share_card_saved",
    "share_card_shared"
  ],
  "local_storage": {
    "primary_key": "bjtu.p005.state.v1",
    "contains_user_generated_content": true,
    "may_contain_images": true,
    "clear_control_available": true,
    "export_control_available": true,
    "legacy_keys": [
      "bjtu_p005_future_me_v2",
      "aiques_future_me_v1"
    ]
  },
  "safety": {
    "predictive_claims": false,
    "diagnostic_use": false,
    "treatment_use": false,
    "future_self_framed_as_possible": true,
    "voice_clone_requires_separate_consent": true,
    "face_media_requires_governance_before_formal_collection": true
  },
  "design": {
    "principle": "Less is more",
    "reference": "../docs/DESIGN_PRINCIPLES.md",
    "constraints": [
      "one screen one primary task",
      "one question at a time during intake",
      "single dominant accent color",
      "advanced features progressively disclosed",
      "avoid decorative AI visual noise"
    ]
  },
  "admin_data": {
    "receives_full_text_snapshot_when_admin_api_configured": true,
    "portrait_binary_in_event_api": false,
    "production_requires_server_auth_and_consent": true
  },
  "research": {
    "methods_mapping": "METHODS_MAPPING.md",
    "original_2024_intake_response_style": "sequential free-text",
    "original_2024_chat_completion_threshold_messages": 16,
    "voice_is_multimodal_extension": true,
    "guided_localization": {
      "gender_options": [
        "男",
        "女"
      ],
      "removes_ab_decision": true,
      "current_role_single_choice": true,
      "important_people_multi_select": true
    }
  },
  "share_card": {
    "size_px": [
      1080,
      1440
    ],
    "formats": [
      "png",
      "web-share-files"
    ],
    "includes": [
      "target horizon",
      "positive qualities",
      "important values",
      "future vignette",
      "future-self quote"
    ],
    "styles": [
      "minimal",
      "warm",
      "night",
      "mint"
    ]
  }
}
